# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose to the client. Used by scripts/seed-users.ts and
# server routes that need to bypass RLS (none in v1 besides seeding).
SUPABASE_SERVICE_ROLE_KEY=

# Optional: local Chromium for PDF generation in development.
# In production (Vercel) @sparticuz/chromium is used automatically.
PUPPETEER_EXECUTABLE_PATH=

# Optional: domain printed inside transfer voucher QR codes (defaults to the request host).
SCANNER_BASE_URL=

# Optional: outbound email (approved visa to the B2B partner) through Resend.
RESEND_API_KEY=
EMAIL_FROM=
